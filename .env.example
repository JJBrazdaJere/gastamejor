# Plantilla de configuración.
# Copiá este archivo a ".env" y completá tus datos reales.
# El archivo ".env" NO se sube a Git (está en .gitignore).

PGHOST=localhost
PGPORT=5432
PGDATABASE=practica_sql
PGUSER=postgres
PGPASSWORD=tu_password_aqui

# --- Correo (verificacion de email de las cuentas) ---
# "test" (por defecto) NO envia correos: imprime el codigo de verificacion
# en la consola. Cambiar a "smtp" cuando tengas un servidor de correo.
CORREO_MODO=test
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@dominio.com
# SMTP_PASSWORD=tu_password_smtp
# SMTP_FROM=GastaMejor <tu-correo@dominio.com>
# SMTP_TLS=1

# --- API HTTP (servidor.py) ---
# API_HOST=127.0.0.1
# API_PUERTO=8000
# Origenes permitidos por CORS, separados por coma ("*" = cualquiera).
# Al publicar, pone el dominio del frontend, ej:
#   API_ORIGENES=https://jjbrazdajere.github.io
API_ORIGENES=*

# --- Sesiones / verificacion ---
# SESION_HORAS=720        # cuanto dura el login (30 dias)
# CODIGO_VIGENCIA_MIN=15  # minutos que vale el codigo de email
