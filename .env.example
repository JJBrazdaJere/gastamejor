# Plantilla de configuración.
# Copiá este archivo a ".env" y completá tus datos reales.
# El archivo ".env" NO se sube a Git (está en .gitignore).

PGHOST=localhost
PGPORT=5432
PGDATABASE=practica_django
PGUSER=postgres
PGPASSWORD=tu_password_aqui

# --- Django (interfaz web) ---
# Generá una con: django-admin shell -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambiar_por_una_clave_secreta_larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
