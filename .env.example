# Ejemplo de configuración. Copialo a ".env" y completá tus datos.
# El archivo ".env" NO se sube a Git (está en .gitignore).

# --- Base de datos (PostgreSQL) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=practica_sql
PGUSER=postgres
PGPASSWORD=cambia_esta_clave

# SSL de la conexión. En local va vacío; en la nube (Neon, etc.) poné "require".
PGSSLMODE=

# --- API HTTP ---
# En local: 127.0.0.1. En un hosting (Render, etc.): 0.0.0.0.
API_HOST=127.0.0.1
# Puerto. Si no se pone, se usa la variable PORT del hosting.
API_PUERTO=8000
# Orígenes permitidos por CORS, separados por coma. "*" = cualquiera.
API_ORIGENES=*

# --- Correo ---
# test = NO envía (imprime el código en consola).
# smtp = envía por SMTP (ideal local; en Render está bloqueado).
# api  = envía por la API HTTP de Brevo (ideal en la nube).
CORREO_MODO=test

# Para CORREO_MODO=smtp:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_clave_smtp
SMTP_FROM=GastaMejor <tu-correo@gmail.com>
SMTP_TLS=1

# Para CORREO_MODO=api:
BREVO_API_KEY=

# --- Sesiones / verificación ---
# Horas que dura una sesión iniciada.
SESION_HORAS=720
# Minutos de vigencia del código de verificación de email.
CODIGO_VIGENCIA_MIN=15
